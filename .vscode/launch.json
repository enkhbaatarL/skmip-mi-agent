    {
      "name": "[🌱]backend: uvicorn (main.py)",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}"
      },
      "justMyCode": false
    },
    {
      "name": "[🌱🌱]backend: gunicorn (main.py)",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "gunicorn",
      "args": [
        "main:app",
        "-k=uvicorn.workers.UvicornWorker",
        "--bind",
        "127.0.0.1:8000",
        "--timeout",
        "3600",
        "--keep-alive",
        "3600",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}"
      },
      "justMyCode": false
    }
  ]
}
