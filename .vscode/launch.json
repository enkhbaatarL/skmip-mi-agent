{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "[🚀]launcher: poetry install + uvicorn",
      "type": "debugpy",
      "request": "launch",
      "python": "${config:python.defaultInterpreterPath}",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--log-level",
        "debug",
        "--env-file",
        "${workspaceFolder}/envs/.env"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Poetry Install",
      "envFile": "${workspaceFolder}/envs/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "APP_CONFIG": "${workspaceFolder}/envs/config.yaml",
        "POETRY_ACTIVE": "0",
        "VIRTUAL_ENV": "",
        "VIRTUAL_ENV_PROMPT": ""

      },
      "justMyCode": false
    },
    {
      "name": "[🌱]backend: uvicorn (main.py)",
      "type": "debugpy",
      "request": "launch",
      "python": "${config:python.defaultInterpreterPath}",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--log-level",
        "debug",
        "--env-file",
        "${workspaceFolder}/envs/.env"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/envs/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "APP_CONFIG": "${workspaceFolder}/envs/config.yaml",
        "POETRY_ACTIVE": "0",
        "VIRTUAL_ENV": "",
        "VIRTUAL_ENV_PROMPT": ""
      },
      "justMyCode": false
    },
    {
      "name": "[🐞]backend: debugpy uvicorn (main.py)",
      "type": "debugpy",
      "request": "launch",
      "python": "${config:python.defaultInterpreterPath}",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--log-level",
        "debug",
        "--env-file",
        "${workspaceFolder}/envs/.env"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/envs/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "APP_CONFIG": "${workspaceFolder}/envs/config.yaml",
        "POETRY_ACTIVE": "0",
        "VIRTUAL_ENV": "",
        "VIRTUAL_ENV_PROMPT": ""
      },
      "justMyCode": false
    },
    {
      "name": "[🌱🌱]backend: gunicorn (main.py)",
      "type": "debugpy",
      "request": "launch",
      "python": "${config:python.defaultInterpreterPath}",
      "module": "gunicorn",
      "args": [
        "main:app",
        "-k=uvicorn.workers.UvicornWorker",
        "--bind",
        "127.0.0.1:8000",
        "--timeout",
        "3600",
        "--keep-alive",
        "3600"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/envs/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "APP_CONFIG": "${workspaceFolder}/envs/config.yaml",
        "POETRY_ACTIVE": "0",
        "VIRTUAL_ENV": "",
        "VIRTUAL_ENV_PROMPT": ""
      },
      "justMyCode": false
    }
  ]
}
