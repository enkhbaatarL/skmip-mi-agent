{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "[🚀]launcher: poetry install (.venv) + uvicorn",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "preLaunchTask": "Poetry Install (.venv)",
      "envFile": "${workspaceFolder}/envs/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "APP_CONFIG": "${workspaceFolder}/envs/config.yaml"
      },
      "justMyCode": false
    },
    {
      "name": "[🌱]backend: uvicorn (main.py)",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "envFile": "${workspaceFolder}/envs/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "APP_CONFIG": "${workspaceFolder}/envs/config.yaml"
      },
      "justMyCode": false
    },
    {
      "name": "[🌱🌱]backend: gunicorn (main.py)",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "gunicorn",
      "args": [
        "main:app",
        "-k=uvicorn.workers.UvicornWorker",
        "--bind",
        "127.0.0.1:8000",
        "--timeout",
        "3600",
        "--keep-alive",
        "3600"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "envFile": "${workspaceFolder}/envs/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "APP_CONFIG": "${workspaceFolder}/envs/config.yaml"
      },
      "justMyCode": false
    },
    {
      "name": "[🍄]backoffice: frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --host 127.0.0.1",
      "cwd": "${workspaceFolder}/backoffice/frontend"
    },
    {
      "name": "[🍄‍🟫]backoffice: backend",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "uvicorn",
      "args": [
        "backoffice.backend.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "9010",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "BACKOFFICE_HOST": "127.0.0.1",
        "BACKOFFICE_PORT": "9010",
        "DEFAULT_AGENT_BASE_URL": "http://127.0.0.1:8000",
        "BACKOFFICE_CALLBACK_LOG_PATH": "${workspaceFolder}/local/output/backoffice_callbacks.jsonl"
      },
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "[🥗]backoffice: frontend + backend",
      "configurations": [
        "[🍄]backoffice: frontend",
        "[🍄‍🟫]backoffice: backend"
      ],
      "stopAll": true
    }
  ]
}
