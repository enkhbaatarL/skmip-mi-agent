{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "[🌱]backend: uvicorn (main.py)",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "SKGAS_AGENT_ENV_FILE": "${workspaceFolder}/envs/skgas_agent/env.txt",
        "REF_TEMPLATE_REGISTRY_PATH": "${workspaceFolder}/apps/common/configs/template_registry.json"

      },
      "justMyCode": false
    },
    {
      "name": "[🌱🌱]backend: gunicorn (main.py)",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "gunicorn",
      "args": [
        "main:app",
        "-k=uvicorn.workers.UvicornWorker",
        "--bind",
        "127.0.0.1:8000",
        "--timeout",
        "3600",
        "--keep-alive",
        "3600",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
        "SKGAS_AGENT_ENV_FILE": "${workspaceFolder}/envs/skgas_agent/env.txt",
        "REF_TEMPLATE_REGISTRY_PATH": "${workspaceFolder}/scripts/scenario_generation/template_registry.json"
      },
      "justMyCode": false
    }
  ]
}
