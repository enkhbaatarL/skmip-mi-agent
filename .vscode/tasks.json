{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Poetry Install",
            "type": "process",
            "command": "poetry",
            "args": [
                "install"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "POETRY_ACTIVE": "0",
                    "VIRTUAL_ENV": "",
                    "VIRTUAL_ENV_PROMPT": ""
                }
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Poetry Install (.venv)",
            "type": "process",
            "command": "poetry",
            "args": [
                "install"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "POETRY_VIRTUALENVS_CREATE": "true",
                    "POETRY_VIRTUALENVS_IN_PROJECT": "true",
                    "POETRY_VIRTUALENVS_PREFER_ACTIVE_PYTHON": "false"
                }
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Run FastAPI",
            "type": "shell",
            "command": "python ${workspaceFolder}/simple_graph/graph.py",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Docker Build",
            "type": "shell",
            "command": "docker build -f ${workspaceFolder}/Dockerfile -t skmidemoacr.azurecr.io/mi-agent-scenario:${input:dockerImageTag} ${workspaceFolder}",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Docker Push",
            "type": "shell",
            "command": "docker push skmidemoacr.azurecr.io/mi-agent-scenario:${input:dockerImageTag}",
            "problemMatcher": [],
            "group": "build"
        }
    ],
    "inputs": [
        {
            "id": "dockerImageTag",
            "type": "promptString",
            "description": "Docker image tag",
            "default": "v0.0.2"
        }
    ]
}
