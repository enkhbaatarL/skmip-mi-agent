# Safe, committed defaults for DB/LLM-independent automated contract tests.
# Real proposal and target-DB checks must use their separately authorized environment.
APP_CONFIG=envs/config.yaml
METADATA_DB_TYPE=mysql
METADATA_DB_HOST=127.0.0.1
METADATA_DB_PORT=3306
METADATA_DB_NAME=model_parameter_contract_test
METADATA_DB_USERNAME=model_parameter_contract_test
METADATA_DB_PASSWORD=model_parameter_contract_test
MODEL_PARAMETER_RESOURCE_STORAGE__ENABLED=false
MLFLOW_TRACING_ENABLED=false
