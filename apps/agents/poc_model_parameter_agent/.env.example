# Runtime
COMPOSE_PROJECT_NAME=poc-model-parameter
AGENT_MODE=mock
API_PORT=8000
WEB_PORT=5173
MYSQL_PORT=13307
MYSQL_IMAGE=mysql:8.4

# MySQL (local-only example credentials; use different values outside local development)
MYSQL_DATABASE=poc_model_parameter
MYSQL_USER=poc_agent
MYSQL_PASSWORD=poc_agent
MYSQL_ROOT_PASSWORD=poc_root
DATABASE_URL=mysql+pymysql://poc_agent:poc_agent@mysql:3306/poc_model_parameter?charset=utf8mb4

# API and deterministic pipeline
API_CORS_ORIGINS=["http://localhost:5173"]
MAX_SCENARIO_PAYLOAD_BYTES=1048576

# Learning worker
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=20
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_MAX_SECONDS=30

# Isolated MySQL used by the Compose `test` profile
TEST_MYSQL_PORT=3308
TEST_MYSQL_IMAGE=mysql:8.4
TEST_MYSQL_DATABASE=poc_model_parameter_test
TEST_MYSQL_USER=poc_test
TEST_MYSQL_PASSWORD=poc_test
TEST_MYSQL_ROOT_PASSWORD=poc_test_root

# Browser E2E (normally overridden by the e2e Compose service)
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8000
