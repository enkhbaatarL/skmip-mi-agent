{
  "_meta": {
    "description": "Multi-Scenario Template Registry — Event Type별 Dimension/Enum/Compatibility Rule",
    "schema_version": "0.1.0",
    "registry_keys": "event_type_l1_l2 (예: 'weather_climate::winter_cold_wave')"
  },

  "templates": {
    "weather_climate::winter_cold_wave": {
      "label_ko": "기상·기후 / 겨울 한파",
      "template_dimensions_total": 6,
      "dimensions": [
        {
          "dimension_id": "duration_months",
          "label_ko": "지속 기간 (동절기 월 범위)",
          "description": "동절기(11월~익년 3월) 중 한파 시나리오가 적용되는 월 범위의 길이",
          "enum": [
            { "id": "short_burst", "label": "1개월 단발",                "tail": false },
            { "id": "short",       "label": "2개월 부분 동절기",         "tail": false },
            { "id": "mid_peak",    "label": "3개월 (피크 집중)",         "tail": false },
            { "id": "extended",    "label": "4개월",                     "tail": true  },
            { "id": "full_season", "label": "5개월 전 동절기",           "tail": true  }
          ]
        },
        {
          "dimension_id": "temperature_anomaly",
          "label_ko": "기온 강도 (한파, 참조 기준 대비 -℃ 편차)",
          "description": "평년(5년/30년 평균) 또는 최근 예보 대비 음의 기온 편차",
          "enum": [
            { "id": "normal",   "label": "평년 수준 (±0.5℃ 이내)",   "tail": false },
            { "id": "mild",     "label": "약한 한파 (-0.5~-1.5℃)",   "tail": false },
            { "id": "moderate", "label": "중간 한파 (-1.5~-3℃)",     "tail": false },
            { "id": "severe",   "label": "강한 한파 (-3~-5℃)",       "tail": true  },
            { "id": "extreme",  "label": "극한 한파 (-5℃ 이하)",     "tail": true  }
          ]
        },
        {
          "dimension_id": "affected_region_scope",
          "label_ko": "영향 지역 범위",
          "description": "한파 영향이 미치는 지역의 지리적 범위/규모",
          "enum": [
            { "id": "single_country", "label": "단일 국가",                      "tail": false },
            { "id": "ne_asia_bloc",   "label": "동북아 권역 (한·중·일)",         "tail": false },
            { "id": "europe_focus",   "label": "유럽 단독",                      "tail": false },
            { "id": "multi_region",   "label": "다권역 (동북아+유럽 등)",        "tail": true  },
            { "id": "hemispheric",    "label": "북반구 광역 (Polar Vortex급)",   "tail": true  }
          ]
        },
        {
          "dimension_id": "eu_storage_drawdown",
          "label_ko": "유럽 재고 소진 영향 (평년 대비 %P 편차)",
          "description": "동절기 종료 시점 EU 재고율의 평년 대비 편차 — 한파 시나리오의 실질 Driver",
          "enum": [
            { "id": "s1_surplus", "label": "+10%P 이상 (여유, Bearish)",   "tail": false },
            { "id": "s2_normal",  "label": "±5%P 이내 (평이)",             "tail": false },
            { "id": "s3_concern", "label": "-5~-10%P (우려 부상)",         "tail": false },
            { "id": "s4_policy",  "label": "-10~-15%P (정책 논의)",        "tail": true  },
            { "id": "s5_crisis",  "label": "-15%P 이상 (위기·강제 배분)",  "tail": true  }
          ]
        },
        {
          "dimension_id": "heating_demand_increase",
          "label_ko": "난방 수요 증가 (Mt)",
          "description": "한파로 인한 추가 난방용 가스 수요 증가량 (B 기온 강도와 동시 선택 금지 — E는 B의 결과 축)",
          "enum": [
            { "id": "s1_lt_1mt",    "label": "<1 Mt",   "tail": false },
            { "id": "s2_1_3mt",     "label": "1~3 Mt",  "tail": false },
            { "id": "s3_3_6mt",     "label": "3~6 Mt",  "tail": false },
            { "id": "s4_6_12mt",    "label": "6~12 Mt", "tail": true  },
            { "id": "s5_12mt_plus", "label": "12 Mt+",  "tail": true  }
          ]
        },
        {
          "dimension_id": "spot_price_spike",
          "label_ko": "Spot 가격 반응 ($/MMBtu)",
          "description": "한파로 인한 지역 Spot 가격 spike 규모",
          "enum": [
            { "id": "s1_none",    "label": "없음",     "tail": false },
            { "id": "s2_low",     "label": "$0.3~$1",  "tail": false },
            { "id": "s3_mid",     "label": "$1~$3",    "tail": false },
            { "id": "s4_high",    "label": "$3~$5",    "tail": true  },
            { "id": "s5_extreme", "label": "$5+",      "tail": true  }
          ]
        }
      ],
      "compatibility_rules": [
        {
          "rule_id": "WIN_C1",
          "type": "intensity_contradiction",
          "description": "평년 수준 기온(편차 ≈0℃)에서 EU 재고가 정책·위기 수준으로 소진되는 것은 인과상 모순",
          "forbid": {
            "temperature_anomaly": ["normal"],
            "eu_storage_drawdown": ["s4_policy", "s5_crisis"]
          }
        },
        {
          "rule_id": "WIN_C2",
          "type": "intensity_contradiction",
          "description": "평년 수준 기온에서 Spot 가격이 $1/MMBtu 이상 spike하는 것은 시장 통념상 모순",
          "forbid": {
            "temperature_anomaly": ["normal"],
            "spot_price_spike": ["s3_mid", "s4_high", "s5_extreme"]
          }
        },
        {
          "rule_id": "WIN_C3",
          "type": "physical_contradiction",
          "description": "1개월 단발 한파에서 EU 재고가 정책·위기 수준으로 소진되는 것은 시간상 물리적으로 성립 불가",
          "forbid": {
            "duration_months": ["short_burst"],
            "eu_storage_drawdown": ["s4_policy", "s5_crisis"]
          }
        },
        {
          "rule_id": "WIN_C4",
          "type": "intensity_contradiction",
          "description": "다권역·북반구 광역 한파에서 난방 수요 증가가 1~3 Mt 이하라는 조합은 모순",
          "forbid": {
            "affected_region_scope": ["multi_region", "hemispheric"],
            "heating_demand_increase": ["s1_lt_1mt", "s2_1_3mt"]
          }
        },
        {
          "rule_id": "WIN_C5",
          "type": "intensity_contradiction",
          "description": "EU 재고가 정책·위기 수준으로 소진되었는데 Spot 반응이 없음/저($1 미만)인 것은 모순",
          "forbid": {
            "eu_storage_drawdown": ["s4_policy", "s5_crisis"],
            "spot_price_spike": ["s1_none", "s2_low"]
          }
        },
        {
          "rule_id": "WIN_C6",
          "type": "physical_contradiction",
          "description": "극한 한파(-5℃ 이하)에서 난방 수요 증가가 1Mt 미만이라는 조합은 인과상 모순",
          "forbid": {
            "temperature_anomaly": ["extreme"],
            "heating_demand_increase": ["s1_lt_1mt"]
          }
        },
        {
          "rule_id": "WIN_C7",
          "type": "intensity_contradiction",
          "description": "극한 한파 + 동북아·유럽 다권역 영향에서 Spot 반응이 없음/저인 것은 시장 통념상 비현실적",
          "forbid": {
            "temperature_anomaly": ["extreme"],
            "spot_price_spike": ["s1_none", "s2_low"]
          }
        }
      ]
    },

    "weather_climate::summer_heat_wave": {
      "label_ko": "기상·기후 / 여름 고온",
      "template_dimensions_total": 6,
      "dimensions": [
        {
          "dimension_id": "duration_months",
          "label_ko": "지속 기간 (하절기 월 범위)",
          "description": "하절기(6~9월) 및 shoulder season(4~5월, 동남아·인도 조기 폭염 포함) 중 적용 월 범위의 길이",
          "enum": [
            { "id": "shoulder_only", "label": "shoulder season만 (4~5월)",     "tail": false },
            { "id": "short",         "label": "1~2개월 부분",                  "tail": false },
            { "id": "mid_peak",      "label": "3개월 피크 (7~9월)",            "tail": false },
            { "id": "extended",      "label": "4개월 전 하절기 (6~9월)",       "tail": true  },
            { "id": "prolonged",     "label": "5개월+ (shoulder+하절기 결합)", "tail": true  }
          ]
        },
        {
          "dimension_id": "temperature_anomaly",
          "label_ko": "기온 강도 (고온, 참조 기준 대비 +℃ 편차)",
          "description": "평년(5년/30년 평균) 또는 최근 예보 대비 양의 기온 편차",
          "enum": [
            { "id": "normal",   "label": "평년 수준 (±0.5℃ 이내)",   "tail": false },
            { "id": "mild",     "label": "약한 고온 (+0.5~+1.5℃)",   "tail": false },
            { "id": "moderate", "label": "중간 고온 (+1.5~+3℃)",     "tail": false },
            { "id": "severe",   "label": "강한 폭염 (+3~+5℃)",       "tail": true  },
            { "id": "extreme",  "label": "극한 폭염 (+5℃ 이상)",     "tail": true  }
          ]
        },
        {
          "dimension_id": "affected_region_scope",
          "label_ko": "영향 지역 범위",
          "description": "고온 영향이 미치는 지역의 지리적 범위/규모",
          "enum": [
            { "id": "sea_india_only", "label": "동남아·인도 단독 (조기 폭염)",   "tail": false },
            { "id": "single_ne",      "label": "동북아 단일국",                  "tail": false },
            { "id": "ne_asia_multi",  "label": "동북아 다국 (한·중·일 동시)",    "tail": false },
            { "id": "multi_region",   "label": "다권역 (동북아+유럽/미국)",      "tail": true  },
            { "id": "global",         "label": "글로벌 (전 지역 동시 폭염)",     "tail": true  }
          ]
        },
        {
          "dimension_id": "eu_injection_pace",
          "label_ko": "유럽 비축 속도 영향 (보조 축, 평년 대비 %P)",
          "description": "하절기 비축 진행도의 평년 대비 편차 — 여름은 보조 축(통상 S1~S2 분포)",
          "enum": [
            { "id": "s1_above_normal", "label": "정상 비축 (평년+)",                    "tail": false },
            { "id": "s2_normal",       "label": "평년 수준 비축",                       "tail": false },
            { "id": "s3_slow",         "label": "비축 속도 저하 (-5%P)",                "tail": false },
            { "id": "s4_delayed",      "label": "비축 중단·지연 (-5~-10%P)",            "tail": true  },
            { "id": "s5_failed",       "label": "비축 불가 (-10%P+, 동절기 위기 예고)", "tail": true  }
          ]
        },
        {
          "dimension_id": "cooling_power_demand_increase",
          "label_ko": "냉방·발전용 가스 수요 증가 (Mt)",
          "description": "고온으로 인한 냉방·발전용 추가 가스 수요 증가량 (동북아 합산 기준; B 기온 강도와 동시 선택 금지)",
          "enum": [
            { "id": "s1_lt_1mt",    "label": "<1 Mt",   "tail": false },
            { "id": "s2_1_3mt",     "label": "1~3 Mt",  "tail": false },
            { "id": "s3_3_6mt",     "label": "3~6 Mt",  "tail": false },
            { "id": "s4_6_12mt",    "label": "6~12 Mt", "tail": true  },
            { "id": "s5_12mt_plus", "label": "12 Mt+",  "tail": true  }
          ]
        },
        {
          "dimension_id": "spot_price_spike",
          "label_ko": "Spot 가격 반응 ($/MMBtu)",
          "description": "고온으로 인한 지역 Spot 가격 spike 규모 (순수 기상 요인은 S2~S3 집중, S4~S5는 Cross-L1 결합 시)",
          "enum": [
            { "id": "s1_none",    "label": "없음",     "tail": false },
            { "id": "s2_low",     "label": "$0.3~$1",  "tail": false },
            { "id": "s3_mid",     "label": "$1~$3",    "tail": false },
            { "id": "s4_high",    "label": "$3~$5",    "tail": true  },
            { "id": "s5_extreme", "label": "$5+",      "tail": true  }
          ]
        }
      ],
      "compatibility_rules": [
        {
          "rule_id": "SUM_C1",
          "type": "intensity_contradiction",
          "description": "평년 수준 기온(편차 ≈0℃)에서 냉방·발전 수요가 6Mt 이상 급증하는 것은 인과상 모순",
          "forbid": {
            "temperature_anomaly": ["normal"],
            "cooling_power_demand_increase": ["s4_6_12mt", "s5_12mt_plus"]
          }
        },
        {
          "rule_id": "SUM_C2",
          "type": "intensity_contradiction",
          "description": "평년 수준 기온에서 Spot 가격이 $1/MMBtu 이상 spike하는 것은 시장 통념상 모순",
          "forbid": {
            "temperature_anomaly": ["normal"],
            "spot_price_spike": ["s3_mid", "s4_high", "s5_extreme"]
          }
        },
        {
          "rule_id": "SUM_C3",
          "type": "intensity_contradiction",
          "description": "동남아·인도 단독 영향에서 냉방·발전 수요가 6Mt 이상이라는 조합은 시장 규모상 모순 (동남아 단독 임팩트 小)",
          "forbid": {
            "affected_region_scope": ["sea_india_only"],
            "cooling_power_demand_increase": ["s4_6_12mt", "s5_12mt_plus"]
          }
        },
        {
          "rule_id": "SUM_C4",
          "type": "physical_contradiction",
          "description": "shoulder season만 적용되는 단기 고온에서 EU 비축이 완전 실패(-10%P+)하는 것은 시간상 물리적으로 성립 불가",
          "forbid": {
            "duration_months": ["shoulder_only"],
            "eu_injection_pace": ["s4_delayed", "s5_failed"]
          }
        },
        {
          "rule_id": "SUM_C5",
          "type": "physical_contradiction",
          "description": "극한 폭염(+5℃ 이상)에서 냉방·발전 수요가 1Mt 미만이라는 조합은 인과상 모순",
          "forbid": {
            "temperature_anomaly": ["extreme"],
            "cooling_power_demand_increase": ["s1_lt_1mt"]
          }
        },
        {
          "rule_id": "SUM_C6",
          "type": "intensity_contradiction",
          "description": "냉방·발전 수요가 12Mt 이상 급증했는데 Spot 반응이 없음/저($1 미만)인 것은 시장 통념상 모순",
          "forbid": {
            "cooling_power_demand_increase": ["s5_12mt_plus"],
            "spot_price_spike": ["s1_none", "s2_low"]
          }
        },
        {
          "rule_id": "SUM_C7",
          "type": "intensity_contradiction",
          "description": "다권역·글로벌 폭염에서 냉방·발전 수요가 1~3 Mt 이하라는 조합은 규모상 모순",
          "forbid": {
            "affected_region_scope": ["multi_region", "global"],
            "cooling_power_demand_increase": ["s1_lt_1mt", "s2_1_3mt"]
          }
        }
      ]
    }
  }
}
