            "damage_cause": ["technical"]
          }
        },
        {
          "rule_id": "PIP_C6",
          "type": "duration_contradiction",
          "description": "복구 기간 1주 이내인데 Flow 감소가 70% 이상이라는 조합은 시간 구조상 비현실적",
          "forbid": {
            "recovery_period": ["under_1w"],
            "flow_reduction": ["70_95pct", "complete"]
