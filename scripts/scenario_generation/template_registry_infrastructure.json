      "compatibility_rules": [
        {
          "rule_id": "LIQ_C1",
          "type": "duration_contradiction",
          "description": "복구 기간 1주 이내인데 Cargo 지연이 16카고 이상인 것은 물리적으로 모순",
          "forbid": {
            "recovery_period": ["under_1w"],
            "cargo_delay_scale": ["16_30", "30_plus"]
          }
        },
        {
          "rule_id": "LIQ_C2",
          "type": "physical_contradiction",
          "description": "시설 영구 손실인데 복구 기간이 6개월 이내라는 조합은 정의상 모순",
          "forbid": {
            "affected_trains": ["permanent_loss"],
            "recovery_period": ["under_1w", "2_4w", "1_3M", "3_6M"]
          }
        },
        {
          "rule_id": "LIQ_C3",
          "type": "physical_contradiction",
          "description": "Feedgas 100% 중단인데 Cargo 지연이 5카고 이하인 것은 인과 경로상 모순",
          "forbid": {
            "feedgas_impact": ["complete_stop"],
            "cargo_delay_scale": ["1_2", "3_5"]
          }
        },
        {
          "rule_id": "LIQ_C4",
          "type": "intensity_contradiction",
          "description": "시설 영구 손실인데 Force Majeure를 미선언/검토 중인 것은 계약 통념상 비현실적",
          "forbid": {
            "affected_trains": ["permanent_loss"],
            "force_majeure_status": ["not_declared", "under_review"]
          }
        },
        {
          "rule_id": "LIQ_C5",
          "type": "intensity_contradiction",
          "description": "전 Train 영향인데 Offtaker 계약이 정상 이행이라는 조합은 모순",
          "forbid": {
            "affected_trains": ["all", "permanent_loss"],
            "offtaker_contract_status": ["normal"]
          }
        },
        {
          "rule_id": "LIQ_C6",
          "type": "physical_contradiction",
          "description": "복구 기간 1주 이내인데 영향 Train이 전 Train/영구 손실이라는 조합은 물리적으로 모순",
          "forbid": {
            "recovery_period": ["under_1w"],
            "affected_trains": ["all", "permanent_loss"]
          }
        },
        {
          "rule_id": "LIQ_C7",
          "type": "intensity_contradiction",
          "description": "Cargo 지연이 30카고+ 인데 Offtaker 계약이 정상이라는 조합은 모순",
          "forbid": {
            "cargo_delay_scale": ["30_plus"],
            "offtaker_contract_status": ["normal", "delivery_delay"]
          }
        }
      ]
    },

